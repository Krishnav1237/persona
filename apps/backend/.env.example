# ===========================================
# PersonaOS Backend Environment Configuration
# ===========================================

# Node Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://personaos:personaos_dev_password@localhost:5432/personaos

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_TTL=60       # seconds
RATE_LIMIT_MAX=100      # requests per TTL

# Telegram (for bot integration)
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Email (for email integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Logging
LOG_LEVEL=debug
